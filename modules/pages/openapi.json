  "paths": {
    "/api/pages/page": {
      "get": {
        "summary": "Read Page",
        "description": "The live page at `address` (`/about`), or `{moved}` for an address a live page left.",
        "operationId": "read_page_api_pages_page_get",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 61,
              "title": "Address"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/LivePage"
                    },
                    {
                      "$ref": "#/components/schemas/Moved"
                    }
                  ],
                  "title": "Response Read Page Api Pages Page Get"
                }
              }
            }
          },
          "422": {
            "description": "What was sent isn't valid (`kernel.invalid_request`), or the route refused it with its own code, such as `auth.password_rejected`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "A problem (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
