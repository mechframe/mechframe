{
  "openapi": "3.1.0",
  "info": {
    "title": "Audio player",
    "version": "0.1.0"
  },
  "paths": {
    "/api/audio-player/settings": {
      "get": {
        "summary": "Read Settings",
        "description": "Whether the next track plays when one ends, and how long a play takes to count.\nBuilt with `answer`, as a route that sets a header is (SPEC 7).",
        "operationId": "read_settings_api_audio_player_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerSettings"
                }
              }
            }
          },
          "default": {
            "description": "A problem (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PlayerSettings": {
        "properties": {
          "autoplay_next": {
            "type": "boolean",
            "title": "Autoplay Next"
          },
          "count_after_seconds": {
            "type": "integer",
            "title": "Count After Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "autoplay_next",
          "count_after_seconds"
        ],
        "title": "PlayerSettings",
        "description": "What the public player needs to know, read once per page."
      },
      "Problem": {
        "title": "Problem",
        "description": "RFC 9457 problem details (SPEC 7): `type` is `urn:mechframe:problem:<code>`, `code` is stable, and field errors are in `errors` by dotted path. Some problems carry more members, such as `retry_after`.",
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "additionalProperties": true
      }
    }
  }
}
