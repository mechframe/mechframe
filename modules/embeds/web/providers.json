      "allow": "",
      "hosts": [],
      "kinds": {
        "album": {"shape": "strip-120", "words": "An album on Bandcamp",
                  "player": "https://bandcamp.com/EmbeddedPlayer/album={id}/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/artwork=small/transparent=true/"},
        "track": {"shape": "strip-120", "words": "A track on Bandcamp",
