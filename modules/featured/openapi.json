          "default": {
            "description": "A problem (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "New Slot",
        "description": "A new slot. 409 `featured.key_taken`; 422 `featured.unknown_type`.",
        "operationId": "new_slot_api_featured_admin_slots_post",
