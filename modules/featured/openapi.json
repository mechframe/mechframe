  "paths": {
    "/api/featured/slots/{key}": {
      "get": {
        "summary": "Read Live Slot",
        "description": "What's live in the slot now, in order. Built with `answer`, as a route\nthat sets a header is (SPEC 7).",
        "operationId": "read_live_slot_api_featured_slots__key__get",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveSlot"
                }
              }
            }
          },
          "422": {
            "description": "What was sent isn't valid (`kernel.invalid_request`), or the route refused it with its own code, such as `auth.password_rejected`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "A problem (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/featured/admin/slots": {
      "get": {
        "summary": "List Slots",
        "description": "Every slot with its counts and what's live first, in the order they were\nmade, and the types a slot may take.",
