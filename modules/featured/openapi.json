    "/api/featured/admin/slots/{key}/placements": {
      "put": {
        "summary": "Save Placements",
        "description": "The whole list in one save, live at once. 409 `featured.changed` on a\nstale `version`, with the slot as it is now.",
        "operationId": "save_placements_api_featured_admin_slots__key__placements_put",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
